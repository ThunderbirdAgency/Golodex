# ---------------------------------------------------------------------------
# Golodex environment
#
# The app boots and renders the built-in seed pages (/hlt, /demo) with NONE of
# these set. Add them as each capability is switched on.
# ---------------------------------------------------------------------------

# Canonical origin. Used for absolute URLs in metadata, vCards and API responses.
NEXT_PUBLIC_SITE_URL=https://golodex.com

# --- Supabase --------------------------------------------------------------
# Required to persist pages, leads and analytics.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Bypasses RLS — never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# --- Automation API --------------------------------------------------------
# Bootstrap key for /api/v1/*, used before keys are provisioned in the database.
# Generate with:  openssl rand -hex 24
GOLODEX_API_KEY=

# --- AI page assistant -----------------------------------------------------
# Powers the "Ask about me" block. Without it the block returns a clear
# "not switched on" message rather than failing silently.
ANTHROPIC_API_KEY=

# --- Builder ---------------------------------------------------------------
# The builder's save endpoint is CLOSED unless this is set. The browser must
# present a matching `gx_editor` cookie.
#
# This is a single-operator lock for preview deploys: one token currently grants
# edit rights to EVERY page. Replace it with real per-account auth before anyone
# but you can reach /edit.
GOLODEX_EDITOR_TOKEN=

# --- GoHighLevel -----------------------------------------------------------
# Agency-level Private Integration Token. Required ONLY for creating
# sub-accounts, which GHL gates to the Agency Pro ($497) plan.
GHL_AGENCY_TOKEN=
GHL_COMPANY_ID=

# The shared "golodex.com" sub-account. Every lead from a free or gifted page
# lands here, tagged `page:<slug>`.
GHL_DEFAULT_LOCATION_ID=
GHL_DEFAULT_LOCATION_TOKEN=

# Snapshot loaded into each newly provisioned sub-account (pipelines, workflows).
GHL_SNAPSHOT_ID=
